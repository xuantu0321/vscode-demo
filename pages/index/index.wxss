.page { min-height: 100vh; padding: 42rpx 36rpx 150rpx; box-sizing: border-box; background: #F5F7FB; }
.topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:38rpx; }
.brand { color:#202B3C; font-size:34rpx; font-weight:800; letter-spacing:3rpx; }
.brand-sub { margin-top:6rpx; color:#8A95A6; font-size:21rpx; letter-spacing:2rpx; }
.avatar { width:76rpx; height:76rpx; border-radius:50%; background:#E7EEFA; display:flex; align-items:center; justify-content:center; }
.avatar-text { color:#3979D8; font-size:30rpx; font-weight:700; }
.hero { padding:34rpx 30rpx 26rpx; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#263B5B,#17263F); overflow:hidden; box-shadow:0 16rpx 36rpx rgba(31,55,88,.12); }
.hero-tag { color:#A9C6F2; font-size:19rpx; letter-spacing:4rpx; font-weight:700; }
.hero-title { margin-top:20rpx; font-size:43rpx; line-height:1.4; font-weight:800; }
.blue { color:#79B2FF; }
.hero-desc { margin-top:12rpx; color:#C1CCDA; font-size:23rpx; line-height:1.7; }
.hero-board { height:170rpx; margin-top:22rpx; border-radius:18rpx; background:rgba(255,255,255,.07); display:flex; align-items:center; justify-content:space-around; }
.mini-grid { width:180rpx; height:130rpx; position:relative; background-image:linear-gradient(rgba(221,190,132,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(221,190,132,.5) 1px,transparent 1px); background-size:32rpx 32rpx; }
.mini-stone { position:absolute; width:25rpx; height:25rpx; border-radius:50%; box-shadow:0 3rpx 6rpx #1116; }
.black { background:linear-gradient(135deg,#555,#050505); }.white { background:linear-gradient(135deg,#fff,#cbd2dc); }
.s1 {left:27rpx;top:20rpx}.s2 {left:59rpx;top:52rpx}.s3 {left:91rpx;top:20rpx}.s4 {left:91rpx;top:84rpx}.s5 {left:123rpx;top:52rpx}
.hero-board-label { color:#AEBED2; font-size:18rpx; letter-spacing:3rpx; }
.section-head { margin:38rpx 4rpx 20rpx; }.section-title { color:#202B3C; font-size:32rpx; font-weight:800; }.section-sub { color:#929DAD; font-size:22rpx; margin-top:8rpx; }
.main-action { height:132rpx; padding:0 26rpx; border-radius:22rpx; background:#fff; display:flex; align-items:center; box-shadow:0 8rpx 26rpx rgba(37,62,96,.05); }
.action-icon { width:76rpx; height:76rpx; border-radius:20rpx; display:flex; align-items:center; justify-content:center; font-size:38rpx; font-weight:700; }
.primary-icon { color:#fff; background:#397DE0; }.action-copy { flex:1; margin-left:22rpx; }.action-title { color:#263449; font-size:29rpx; font-weight:750; }.action-desc { color:#98A2B1; font-size:21rpx; margin-top:8rpx; }.arrow,.small-arrow { color:#A9B3C1; font-size:48rpx; }
.action-row { display:flex; gap:20rpx; margin-top:20rpx; }.small-action { flex:1; min-width:0; position:relative; padding:24rpx 20rpx; background:#fff; border-radius:22rpx; box-shadow:0 8rpx 26rpx rgba(37,62,96,.05); }.room-icon { color:#3B83DD; background:#EAF2FF; }.single-icon { color:#16A58A; background:#E7F7F2; }.small-action .action-title { margin-top:20rpx; }.small-action .action-desc { line-height:1.5; min-height:56rpx; }.small-arrow { position:absolute; right:18rpx; bottom:12rpx; font-size:38rpx; }
.bottom-note { text-align:center; color:#AAB3C0; font-size:21rpx; margin-top:34rpx; }
.tabbar { position:fixed; left:0; right:0; bottom:0; height:112rpx; padding-bottom:env(safe-area-inset-bottom); background:rgba(255,255,255,.97); display:flex; justify-content:space-around; align-items:center; box-shadow:0 -5rpx 24rpx rgba(31,55,88,.05); }.tab { display:flex; flex-direction:column; align-items:center; gap:4rpx; color:#9AA5B4; font-size:20rpx; }.tab-symbol { font-size:36rpx; line-height:1.1; }.tab.active { color:#397DE0; font-weight:700; }

.avatar-image { width: 100%; height: 100%; border-radius: 50%; }
