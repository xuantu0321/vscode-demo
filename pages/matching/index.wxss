.page{min-height:100vh;background:#f5f7fb;display:flex;flex-direction:column;align-items:center;padding:120rpx 48rpx;box-sizing:border-box}.orb{width:180rpx;height:180rpx;border-radius:50%;background:#fff;box-shadow:0 16rpx 50rpx #dce4f1;display:flex;align-items:center;justify-content:center;font-size:90rpx}.title{font-size:42rpx;font-weight:700;color:#202b3c;margin-top:44rpx}.sub{font-size:26rpx;color:#8792a5;margin-top:16rpx}.status{margin:90rpx 0 40rpx;color:#64748b;font-size:27rpx;text-align:center;min-height:70rpx}.primary,.cancel{width:100%;border-radius:18rpx}.primary{background:#2878e8;color:#fff}.cancel{background:#e9edf4;color:#526176}
